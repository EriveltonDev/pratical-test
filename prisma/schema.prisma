generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RawInvoice {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  customerNumber String
  referenceMonth String

  electricEnergyKwh    Float?
  electricEnergyAmount Float?

  energySceeeKwh    Float?
  energySceeeAmount Float?

  compensatedEnergyGdIKwh    Float?
  compensatedEnergyGdIAmount Float?

  publicLightingAmount Float?

  processedInvoice ProcessedInvoice?

  @@unique([customerNumber, referenceMonth])
  @@index([customerNumber])
  @@index([referenceMonth])

  @@map("raw_invoices")
}

model ProcessedInvoice {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  customerNumber String
  referenceMonth String

  totalEnergyConsumptionKwh Float
  compensatedEnergyKwh      Float
  totalAmountWithoutGd      Float
  gdSavings                 Float

  rawInvoiceId String     @unique
  rawInvoice   RawInvoice @relation(fields: [rawInvoiceId], references: [id])

  @@index([customerNumber])
  @@index([referenceMonth])

  @@map("processed_invoices")
}
